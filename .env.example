# notebooklm-bridge — environment template.
# Copy to `.env` and fill in.
# The `.env` file is gitignored; never commit real values.

# --- Paths (absolute on the bridge host) ---
NOTEBOOKLM_AUTH_JSON=/opt/notebooklm-bridge/secrets/auth.json
STATE_JSON=/opt/notebooklm-bridge/state.json

# --- Network ---
BACKEND_HOST=0.0.0.0
# BACKEND_PORT / FRONTEND_PORT are STARTING ports. scripts/start-web.sh probes the
# host and, if the starting port is busy, auto-increments up to 10 times (8002 →
# 8003 → … → 8011). The actual selected ports are written to .runtime-ports.json
# and picked up by stop-web.sh / status-web.sh / vite proxy. See CLAUDE.md §3.2.
BACKEND_PORT=8002
FRONTEND_PORT=5175
# Single origin the frontend is served from. Used both for FastAPI CORS allow_origins
# and (optionally) for documenting the LAN URL. NO wildcards — see CLAUDE.md §3.6.
INTERNAL_FRONTEND_ORIGIN=http://localhost:5175

# --- Auth ---
# As of v1.0.3 the bridge authenticates only against X-User-Id (the LAN is
# already the trust boundary). A leftover INTERNAL_AUTH_SHARED_SECRET=... line
# is harmless — backend/config.py ignores unknown env vars.

# --- Behaviour knobs ---
NOTEBOOKLM_KEEPALIVE_SECONDS=1800
ALLOWED_NOTEBOOK_IDS=
RATE_LIMIT_PER_MINUTE=10
RATE_LIMIT_BURST=3
MAX_INFLIGHT_ASKS=8
ASK_TIMEOUT_SECONDS=60
CIRCUIT_BREAKER_COOLDOWN=30

# --- Logging ---
LOG_LEVEL=INFO
